# ==============================================================================
# J.A.R.V.I.S. Environment Configuration Template
# Copy this file to .env and insert your API credentials before launching.
# ==============================================================================

# Google Gemini API Key (Multimodal Vision & Fallback Brain)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (High-Speed Inference - 14,400 daily requests free)
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Telegram Mobile Bridge Bot Token (Remote Voice & Action Control)
# Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Nebius AI Studio & NVIDIA Nemotron-70B (Primary Neural Brain)
# Get from: https://studio.nebius.ai/ or https://build.nvidia.com/
NEBIUS_API_KEY=your_nebius_or_nvidia_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Optional: NVIDIA NIM Direct Alternative
# NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
